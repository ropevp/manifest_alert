<Window x:Class="ManifestAlert.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ManifestAlert.WPF"
        xmlns:vm="clr-namespace:ManifestAlert.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Manifest Alert System" Height="800" Width="1400"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14">

    <Window.Resources>
        <!-- Converter for visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryDark" Padding="16"
                                   materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TruckDelivery" Width="40" Height="40"
                                             VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MANIFEST ALERT SYSTEM"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding Source={x:Static System:DateTime.Now}, StringFormat='Today: {0:dddd, MMMM dd, yyyy}'}"
                                   xmlns:System="clr:namespace:System;assembly=mscorlib"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <!-- Alert Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Active Alerts -->
                    <Border Background="#FF9800" CornerRadius="4" Padding="12,8" Margin="8,0"
                            Visibility="{Binding ActiveAlertCount, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="24" Height="24"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ActiveAlertCount, StringFormat='{}{0} Active'}"
                                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Missed Alerts -->
                    <Border Background="#F44336" CornerRadius="4" Padding="12,8" Margin="8,0"
                            Visibility="{Binding MissedAlertCount, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertOctagon" Width="24" Height="24"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding MissedAlertCount, StringFormat='{}{0} Missed'}"
                                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Mute Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Countdown Display -->
                    <Border Background="#424242" CornerRadius="4" Padding="12,8" Margin="0,0,12,0"
                            Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TimerSand" Width="24" Height="24"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CountdownText}"
                                       FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Mute Button -->
                    <Button Command="{Binding MuteCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40" Padding="24,0" Margin="0,0,8,0">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="VolumeOff" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding MuteButtonText}"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <!-- Unmute Button -->
                    <Button Command="{Binding UnmuteCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40" Padding="24,0"
                            Background="#4CAF50"
                            Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="VolumeHigh" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="UNMUTE" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- CONTENT - Manifest Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <ItemsControl ItemsSource="{Binding Manifests}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="8" Padding="0"
                                             materialDesign:ElevationAssist.Elevation="Dp8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <Border Grid.Row="0" Background="{Binding StatusColor}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Time}"
                                                       FontSize="32" FontWeight="Bold"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="White" Opacity="0.9"/>
                                        </StackPanel>

                                        <materialDesign:PackIcon Grid.Column="1"
                                                                 Kind="ClockOutline"
                                                                 Width="48" Height="48"
                                                                 Foreground="White" Opacity="0.5"
                                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Carriers List -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Carriers}"
                                              Margin="16" Background="Transparent">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="0,0,0,1" Padding="8" Margin="0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Carrier Info -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="16" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter Property="Opacity" Value="0.6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Customer Message -->
                                                        <TextBlock Text="{Binding CustomerMessage}"
                                                                   FontSize="12" Opacity="0.7" Margin="0,4,0,0"
                                                                   Visibility="{Binding CustomerMessage, Converter={StaticResource BoolToVis}}"
                                                                   TextWrapping="Wrap"/>

                                                        <!-- Acknowledged By -->
                                                        <TextBlock Text="{Binding AcknowledgedBy, StringFormat='Ack by: {0}'}"
                                                                   FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                                                                   Visibility="{Binding IsAcknowledged, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <!-- Action Buttons -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <!-- Edit Message Button -->
                                                        <Button Command="{Binding EditMessageCommand}"
                                                                Style="{StaticResource MaterialDesignIconButton}"
                                                                ToolTip="Edit Customer Message"
                                                                Margin="4,0">
                                                            <materialDesign:PackIcon Kind="MessageEdit" />
                                                        </Button>

                                                        <!-- Toggle Acknowledgment Button -->
                                                        <ToggleButton IsChecked="{Binding IsAcknowledged, Mode=OneWay}"
                                                                      Command="{Binding ToggleAcknowledgmentCommand}"
                                                                      Style="{StaticResource MaterialDesignActionToggleButton}"
                                                                      ToolTip="Toggle Acknowledgment"
                                                                      Width="32" Height="32">
                                                            <ToggleButton.Content>
                                                                <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                                                         Width="24" Height="24"/>
                                                            </ToggleButton.Content>
                                                            <materialDesign:ToggleButtonAssist.OnContent>
                                                                <materialDesign:PackIcon Kind="CheckCircle"
                                                                                         Width="24" Height="24"
                                                                                         Foreground="#4CAF50"/>
                                                            </materialDesign:ToggleButtonAssist.OnContent>
                                                        </ToggleButton>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Card Footer -->
                                <Border Grid.Row="2" Background="{DynamicResource MaterialDesignToolBarBackground}"
                                        Padding="16,12">
                                    <Button Command="{Binding AcknowledgeAllCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Content="ACKNOWLEDGE ALL"
                                            HorizontalAlignment="Right"/>
                                </Border>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- FOOTER - Status Bar -->
        <materialDesign:ColorZone Grid.Row="2" Mode="PrimaryLight" Padding="16,8"
                                   materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding MuteStatusText}"
                           VerticalAlignment="Center" FontSize="14"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding Manifests.Count, StringFormat='{}{0} Manifests'}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Refresh">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Mute Overlay (Optional - shows when muted) -->
        <Border Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="False">
            <Grid>
                <materialDesign:PackIcon Kind="VolumeOff"
                                         Width="200" Height="200"
                                         Foreground="White" Opacity="0.1"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
